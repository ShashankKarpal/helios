# Copy this file to .env (gitignored) and fill in your own value.
# Your Apple Developer Team ID, used for code signing when xcodegen generates
# the Helios Bridge project: ios-bridge/generate.sh loads this file and
# refuses a missing or placeholder value (see ios-bridge/README.md).
# Find it under Xcode > Settings > Accounts, or developer.apple.com > Membership.
HELIOS_DEVELOPMENT_TEAM=YOURTEAMID
